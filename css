body {
  margin: 0;
  font-family: 'Inter', sans-serif;
  background: #0e1117;
  color: #f3f4f6;
  line-height: 1.6;
}

.container {
  max-width: 960px;
  margin: 0 auto;
  padding: 2rem;
  text-align: center;
}

header {
  background: linear-gradient(135deg, #1f2937, #111827);
  padding: 5rem 2rem 3rem;
}

h1 {
  font-size: 2.5rem;
  margin-bottom: 1rem;
}

.tagline {
  font-size: 1.2rem;
  font-weight: 600;
  margin-bottom: 0.5rem;
  color: #60f6b5;
}

.subtext {
  font-size: 1rem;
  color: #cbd5e1;
  margin-bottom: 2rem;
}

.cta-buttons .btn {
  display: inline-block;
  margin: 0.5rem;
  padding: 0.75rem 1.5rem;
  font-weight: bold;
  border-radius: 6px;
  text-decoration: none;
  transition: all 0.3s ease-in-out;
}

.primary {
  background-color: #10b981;
  color: #fff;
}

.primary:hover {
  background-color: #059669;
}

.secondary {
  border: 2px solid #10b981;
  color: #10b981;
}

.secondary:hover {
  background-color: #10b981;
  color: #fff;
}

.how-it-works {
  background-color: #111827;
  padding: 3rem 2rem;
}

.steps {
  display: flex;
  flex-direction: column;
  gap: 1.5rem;
}

.step h3 {
  margin-bottom: 0.5rem;
  color: #60f6b5;
}

.step p {
  color: #d1d5db;
}

.why-evergreen {
  background-color: #0e1117;
  padding: 3rem 2rem;
}

.why-evergreen ul {
  list-style: none;
  padding: 0;
  font-size: 1.1rem;
}

.why-evergreen li {
  margin: 0.75rem 0;
  color: #d1d5db;
}

footer {
  background: #1f2937;
  padding: 2rem 1rem;
}

footer p {
  font-size: 1.2rem;
  margin-bottom: 1rem;
}

footer .btn {
  padding: 0.75rem 1.25rem;
  font-weight: bold;
}
